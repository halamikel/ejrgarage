// =============================================================
// admin_dashboard.js — EJR Garage Admin Dashboard
// =============================================================

let masterData = { users: [], appointments: [], vehicles: [] };
let historyData = [];
let currentChatUserId = null;

document.addEventListener("DOMContentLoaded", () => {

    // ── Initial Data Load ────────────────────────────────────
    loadFullSiteData();
    loadAdminChatUsers();
    loadServiceHistory();
    loadParts();
    loadInquiries();
    loadOrders();
    loadBusyDates();

    // ── Live Chat Badge ──────────────────────────────────────
    updateLiveChatBadge();
    setInterval(updateLiveChatBadge, 5000);

    // ── Enter Key Chat Send ──────────────────────────────────
    const adminReplyInput = document.getElementById("adminReplyInput");
    if (adminReplyInput) {
        adminReplyInput.addEventListener("keypress", function (e) {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendAdminReply();
            }
        });
    }

    // ── Global Search Filter ─────────────────────────────────
    const adminSearch = document.getElementById("adminSearch");
    if (adminSearch) {
        adminSearch.addEventListener("input", function (e) {
            const term = e.target.value.toLowerCase();
            renderAppointments(masterData.appointments.filter(a =>
                (a.full_name && a.full_name.toLowerCase().includes(term)) ||
                (a.service_type && a.service_type.toLowerCase().includes(term))
            ));
            renderUsers(masterData.users.filter(u =>
                (u.full_name && u.full_name.toLowerCase().includes(term)) ||
                (u.email && u.email.toLowerCase().includes(term))
            ));
            renderVehicles(masterData.vehicles.filter(v =>
                (v.owner_name && v.owner_name.toLowerCase().includes(term)) ||
                (v.plate_number && v.plate_number.toLowerCase().includes(term)) ||
                (v.model && v.model.toLowerCase().includes(term))
            ));
        });
    }

    // ── Lazy Load History Tab ────────────────────────────────
    const historyTab = document.querySelector('[data-bs-target="#tab-history"]');
    if (historyTab) {
        historyTab.addEventListener("shown.bs.tab", () => {
            if (!historyData.length) loadServiceHistory();
        });
    }

    // ── Chat Sync Loop ───────────────────────────────────────
    setInterval(() => {
        const chatTabActive = document.querySelector("#tab-live-chat")?.classList.contains("show");
        if (chatTabActive) {
            loadAdminChatUsers();
            if (currentChatUserId) loadAdminMessages(currentChatUserId);
        }
    }, 3000);
    
    // ── Busy Dates Button ────────────────────────────────────────
    const btnAddBusyDate = document.getElementById('btnAddBusyDate');
    if (btnAddBusyDate) {
        btnAddBusyDate.addEventListener('click', openBlockDate);
    }

    // ── Tab Click Listeners ──────────────────────────────────
    document.querySelector('[data-bs-target="#tab-parts"]')
        .addEventListener('shown.bs.tab', loadParts);
    document.querySelector('[data-bs-target="#tab-inquiries"]')
        .addEventListener('shown.bs.tab', loadInquiries);
    document.querySelector('[data-bs-target="#tab-orders"]')
        .addEventListener('shown.bs.tab', loadOrders);
    document.querySelector('[data-bs-target="#tab-busy-dates"]')
        .addEventListener('shown.bs.tab', loadBusyDates);

    // ── Realtime Auto-Refresh ────────────────────────────────
    startRealtime();
});




// =============================================================
// CORE DATA LOADERS
// =============================================================

function loadFullSiteData() {
    fetch('api/admin/get_full_site_data.php?t=' + Date.now(), { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            if (data.status === 'success') {
                masterData = data;
                renderAppointments(data.appointments);
                renderUsers(data.users);
                renderVehicles(data.vehicles);
                updateStats(data);
            }
        })
        .catch(err => console.error("Fetch failed:", err));
}

function loadServiceHistory() {
    fetch('api/admin/get_service_history.php', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            if (data.status === 'success') {
                historyData = data.history;
                document.getElementById('badgeHistory').textContent = historyData.length;
                renderHistory(historyData);
            }
        })
        .catch(() => {
            document.getElementById('historyTableBody').innerHTML =
                '<tr><td colspan="6" class="text-center text-danger py-4">Failed to load history.</td></tr>';
        });
}

function loadParts() {
    fetch('api/admin/manage_parts.php', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            if (data.status !== 'success') return;
            document.getElementById('badgeParts').textContent = data.parts.length;
            const tbody = document.getElementById('partsTableBody');
            tbody.innerHTML = data.parts.map(p => `
                <tr>
                    <td><img src="${p.image_url || ''}" style="width:50px;height:40px;object-fit:cover;border-radius:6px;"
                             onerror="this.style.display='none'"></td>
                    <td class="fw-bold">${p.name}</td>
                    <td><span class="badge bg-light text-dark border">${p.category}</span></td>
                    <td>₱${parseFloat(p.price).toLocaleString('en-PH', { minimumFractionDigits: 2 })}</td>
                    <td><span class="badge ${p.stock > 0 ? 'bg-success' : 'bg-danger'}">${p.stock}</span></td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-dark"
                                    onclick="openEditPart(${p.id},'${p.name.replace(/'/g,"\\'")}','${p.description?.replace(/'/g,"\\'")||''}',${p.price},'${p.category}','${p.image_url||''}',${p.stock})">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="deletePart(${p.id},'${p.name.replace(/'/g,"\\'")}')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`).join('');
        });
}

function loadInquiries() {
    fetch('api/admin/manage_parts.php?action=get_inquiries', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            if (data.status !== 'success') return;

            // Filter out responded inquiries for admin view
            const pending = data.inquiries.filter(i => i.status !== 'responded');

            document.getElementById('badgeInquiries').textContent = pending.length;
            const tbody = document.getElementById('inquiriesTableBody');
            tbody.innerHTML = pending.length ? pending.map(i => `
                <tr>
                    <td><span class="badge bg-light text-dark border">${i.part_name}</span></td>
                    <td class="fw-bold">${i.customer_name}</td>
                    <td>${i.contact}</td>
                    <td class="text-muted small">${i.message || '—'}</td>
                    <td>${new Date(i.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
                    <td><span class="badge bg-warning text-dark">pending</span></td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-success"
                                    onclick="updateInquiry(${i.id})">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="deleteInquiry(${i.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`).join('')
            : '<tr><td colspan="7" class="text-center text-muted py-4">No pending inquiries.</td></tr>';
        });
}

function loadOrders() {
    const tbody = document.getElementById('ordersTableBody');
    if (!tbody) return;

    fetch('api/admin/manage_orders.php', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            if (data.status !== 'success') throw new Error(data.message);

            const orders = data.orders ?? [];
            document.getElementById('badgeOrders').textContent = orders.length;

            if (!orders.length) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No orders placed yet.</td></tr>';
                return;
            }

            tbody.innerHTML = orders.map(o => {
                const year      = new Date(o.created_at).getFullYear();
                const orderNo   = `EJR-ORD-${year}-${String(o.id).padStart(5, '0')}`;
                const itemsArr  = typeof o.items === 'string' ? JSON.parse(o.items) : o.items;
                const itemsList = Array.isArray(itemsArr)
                    ? itemsArr.map(i => `${i.name} ×${i.qty}`).join(', ')
                    : o.items;
                const date      = new Date(o.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                const safeName  = o.customer_name.replace(/'/g, "\\'");
                const isPending = o.status.toLowerCase() === 'pending';

                return `
                <tr>
                    <td><code style="color:#b30000;">${orderNo}</code></td>
                    <td class="fw-bold">${o.customer_name}</td>
                    <td>${o.contact}</td>
                    <td class="text-muted small" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"
                        title="${itemsList}">${itemsList}</td>
                    <td class="fw-bold text-danger">₱${parseFloat(o.total_price).toLocaleString('en-PH', { minimumFractionDigits: 2 })}</td>
                    <td>${date}</td>
                    <td>${statusBadge(o.status)}</td>
                    <td>
                        <div class="btn-group">
                            ${isPending ? `
                                <button class="btn btn-sm btn-outline-success"
                                        onclick="updateOrder(${o.id}, '${o.status}', '${safeName}')"
                                        title="Manage">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            ` : ''}
                            <button class="btn btn-sm btn-outline-secondary"
                                    onclick="deleteOrder(${o.id})"
                                    title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
            }).join('');
        })
        .catch(err => {
            console.error('Orders error:', err);
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Failed to load orders. Check API.</td></tr>';
        });
}


// =============================================================
// RENDER FUNCTIONS
// =============================================================

function updateStats(data) {
    document.getElementById("statTotal").textContent    = data.appointments.length;
    document.getElementById("statPending").textContent  = data.appointments.filter(a => a.status === 'Pending').length;
    document.getElementById("statUsers").textContent    = data.users.length;
    document.getElementById("statVehicles").textContent = data.vehicles.length;
    document.getElementById("badgeAppt").textContent    = data.appointments.length;
    document.getElementById("badgeUsers").textContent   = data.users.length;
    document.getElementById("badgeVehs").textContent    = data.vehicles.length;
}

function statusBadge(status) {
    if (!status) return `<span class="badge bg-secondary">Unknown</span>`;
    const s = status.toLowerCase().trim();
    const map = {
        'pending':   'bg-warning text-dark',
        'approved':  'bg-success',
        'confirmed': 'bg-success',
        'completed': 'bg-success',
        'cancelled': 'bg-danger'
    };
    const displayStatus = s.charAt(0).toUpperCase() + s.slice(1);
    return `<span class="badge ${map[s] || 'bg-secondary'}">${displayStatus}</span>`;
}

function renderAppointments(apps) {
    document.getElementById("appointmentTableBody").innerHTML = apps.length
        ? apps.map(a => `
            <tr>
                <td class="fw-bold">${a.full_name || 'Guest'}</td>
                <td><span class="badge bg-light text-dark border">${a.service_type}</span></td>
                <td>${a.vehicle_info || '—'}</td>
                <td>${a.appointment_date
                    ? new Date(a.appointment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                    : '—'}</td>
                <td>${statusBadge(a.status)}</td>
                <td>
                    <button class="btn btn-sm btn-outline-dark" onclick="manageApp(${a.id}, '${a.status}')">
                        <i class="bi bi-pencil-square"></i> Manage
                    </button>
                </td>
            </tr>`).join('')
        : '<tr><td colspan="6" class="text-center text-muted py-4">No appointments found.</td></tr>';
}

function renderUsers(users) {
    if (!users.length) {
        document.getElementById("userTableBody").innerHTML =
            '<tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>';
        return;
    }
    document.getElementById("userTableBody").innerHTML = users.map(u => {
        const name  = u.full_name.replace(/'/g, "\\'");
        const email = u.email.replace(/'/g, "\\'");
        return `
        <tr>
            <td>${u.id}</td>
            <td class="fw-bold">${u.full_name}</td>
            <td>${u.email}</td>
            <td>${u.phone || '—'}</td>
            <td><span class="badge ${u.role_id == 2 ? 'bg-danger' : 'bg-secondary'}">
                ${u.role_id == 2 ? 'Admin' : 'Customer'}
            </span></td>
            <td>${u.created_at
                ? new Date(u.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                : '—'}</td>
            <td>
                <button class="btn btn-sm btn-outline-dark me-1"
                        onclick="editUser(${u.id}, '${name}', '${email}', ${u.role_id})">
                    <i class="bi bi-pencil-square"></i> Edit
                </button>
                <button class="btn btn-sm btn-outline-danger"
                        onclick="deleteUser(${u.id}, '${name}')">
                    <i class="bi bi-trash"></i> Delete
                </button>
            </td>
        </tr>`;
    }).join('');
}

function renderVehicles(vehs) {
    document.getElementById("vehicleTableBody").innerHTML = vehs.length
        ? vehs.map(v => `
            <tr>
                <td class="fw-bold">${v.owner_name || '—'}</td>
                <td>${v.brand || '—'}</td>
                <td>${v.model || '—'}</td>
                <td>${v.year_model || '—'}</td>
                <td><code class="text-uppercase" style="color:#b30000;">${v.plate_number}</code></td>
                <td>${v.fuel_type || '—'}</td>
                <td>${v.transmission || '—'}</td>
            </tr>`).join('')
        : '<tr><td colspan="7" class="text-center text-muted py-4">No vehicles found.</td></tr>';
}

function renderHistory(data) {
    const tbody = document.getElementById('historyTableBody');
    document.getElementById('historyCount').textContent =
        data.length ? `Showing ${data.length} record(s)` : '';

    if (!data.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No service history found.</td></tr>';
        return;
    }

    tbody.innerHTML = data.map(h => {
        const vehicle = h.brand && h.model
            ? `${h.brand} ${h.model} (${h.year_model || '—'})`
            : '—';
        const date = h.appointment_date
            ? new Date(h.appointment_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
            : '—';
        const rawDate = h.appointment_date ? h.appointment_date.substring(0, 10) : '';
        const service = h.service_type.replace(/'/g, "\\'");

        return `
        <tr>
            <td class="fw-bold">${h.full_name || '—'}</td>
            <td><span class="badge bg-light text-dark border">${h.service_type}</span></td>
            <td>${vehicle}</td>
            <td><code class="text-uppercase" style="color:#b30000;">${h.plate_number || '—'}</code></td>
            <td>${date}</td>
            <td>
                <div class="btn-group">
                    <a href="api/admin/generate_receipt.php?id=${h.id}" target="_blank"
                       class="btn btn-sm btn-outline-primary" title="View Receipt">
                        <i class="bi bi-receipt"></i>
                    </a>
                    <button class="btn btn-sm btn-outline-success"
                            onclick="sendReceiptToUser(${h.id}, '${h.full_name.replace(/'/g, "\\'")}')" title="Send Receipt">
                        <i class="bi bi-send"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-dark"
                            onclick="editHistory(${h.id}, '${service}', '${rawDate}')">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            onclick="deleteHistory(${h.id}, '${h.full_name.replace(/'/g, "\\'")}')">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>`;
    }).join('');
}


