function showNotification(message, type = 'success') {
    const isError = type === 'error';
    Swal.fire({
        title: isError ? 'Oops!' : 'Success!',
        text: message,
        icon: type,
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        iconColor: isError ? '#f27474' : '#dc3545',
        background: '#fff',
        color: '#333'
    });
}

