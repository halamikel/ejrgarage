/* EJR Garage Admin Specific Styles */
:root {
    --ejr-red: #e62429;
    --ejr-dark: #121212;
    --ejr-light-bg: #f8f9fa;
    --sidebar-width: 260px;
}

.admin-wrapper {
    display: flex;
    min-height: 100vh;
    background-color: var(--ejr-light-bg);
}

/* Sidebar */
.admin-sidebar {
    width: var(--sidebar-width);
    background-color: var(--ejr-dark);
    color: #ffffff;
    flex-shrink: 0;
    z-index: 1000;
}

.sidebar-header {
    padding: 2rem 1.5rem;
    text-align: center;
    border-bottom: 1px solid #2d2d2d;
}

.sidebar-nav .nav-link {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    color: #adb5bd;
    text-decoration: none;
    transition: all 0.2s;
    border-left: 4px solid transparent;
}

.sidebar-nav .nav-link i {
    font-size: 1.1rem;
    margin-right: 12px;
}

.sidebar-nav .nav-link:hover, 
.sidebar-nav .nav-link.active {
    color: #ffffff;
    background-color: #1e1e1e;
    border-left-color: var(--ejr-red);
}

/* Content Area */
.admin-content {
    flex-grow: 1;
    padding: 2rem;
}

/* Stat Cards */
.stat-card {
    border: none;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    transition: transform 0.2s;
}

.stat-card:hover {
    transform: translateY(-5px);
}

.stat-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    font-size: 1.5rem;
}

/* Table Card */
.admin-table-card {
    border: none;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

.admin-table thead th {
    background-color: #fcfcfc;
    text-transform: uppercase;
    font-size: 0.7rem;
    font-weight: 700;
    color: #6c757d;
    letter-spacing: 0.5px;
}

/* Admin Button on Crimson Header */
#adminAccessContainer .btn-outline-light {
    border-width: 2px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
    transition: all 0.3s ease;
}

#adminAccessContainer .btn-outline-light:hover {
    background: #ffffff;
    color: #e62429; /* Matches EJR Crimson */
    transform: translateY(-2px);
}