// Updated to include userName
function handleSession(userId, action, userName = 'User') {
    fetch('api/admin/accept_session.php', {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: userId, action: action })
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === 'success') {
            if (action === 'accept') {
                currentChatUserId = userId;
                document.getElementById('adminInputArea').classList.remove('d-none');
                
                // Update the title exactly like selectUserChat does
                const titleEl = document.getElementById('chattingWithTitle');
                if (titleEl) {
                    titleEl.innerText = 'Chatting with: ' + userName;
                }

                loadAdminMessages(userId);
            }
            loadAdminChatUsers();

            Swal.fire({
                toast: true,
                position: 'bottom-end',
                icon: action === 'accept' ? 'success' : 'info',
                title: action === 'accept' ? 'Session accepted!' : 'Session declined',
                showConfirmButton: false,
                timer: 2000
            });
        } else {
            Swal.fire('Error', data.message, 'error');
        }
    })
    .catch(err => console.error('Session error:', err));
}

