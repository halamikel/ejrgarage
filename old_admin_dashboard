<script>
let masterData = { users: [], appointments: [], vehicles: [] };
let historyData = [];
let currentChatUserId = null;

document.addEventListener("DOMContentLoaded", () => {
    // =========================
    // INITIAL DATA LOAD
    // =========================
    loadFullSiteData();
    loadAdminChatUsers();
    loadServiceHistory();
    loadParts();
    loadInquiries();
    loadOrders();

    // =========================
    // LIVE CHAT BADGE
    // =========================
    updateLiveChatBadge();
    setInterval(updateLiveChatBadge, 5000);

    // =========================
    // ENTER KEY CHAT SEND
    // =========================
    const adminReplyInput = document.getElementById("adminReplyInput");
    if (adminReplyInput) {
        adminReplyInput.addEventListener("keypress", function (e) {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                sendAdminReply();
            }
        });
    }

    // =========================
    // GLOBAL SEARCH FILTER
    // =========================
    const adminSearch = document.getElementById("adminSearch");
    if (adminSearch) {
        adminSearch.addEventListener("input", function (e) {
            const term = e.target.value.toLowerCase();

            renderAppointments(
                masterData.appointments.filter(a =>
                    (a.full_name && a.full_name.toLowerCase().includes(term)) ||
                    (a.service_type && a.service_type.toLowerCase().includes(term))
                )
            );

            renderUsers(
                masterData.users.filter(u =>
                    (u.full_name && u.full_name.toLowerCase().includes(term)) ||
                    (u.email && u.email.toLowerCase().includes(term))
                )
            );

            renderVehicles(
                masterData.vehicles.filter(v =>
                    (v.owner_name && v.owner_name.toLowerCase().includes(term)) ||
                    (v.plate_number && v.plate_number.toLowerCase().includes(term)) ||
                    (v.model && v.model.toLowerCase().includes(term))
                )
            );
        });
    }

    // =========================
    // LAZY LOAD HISTORY TAB
    // =========================
    const historyTab = document.querySelector('[data-bs-target="#tab-history"]');
    if (historyTab) {
        historyTab.addEventListener("shown.bs.tab", () => {
            if (!historyData.length) loadServiceHistory();
        });
    }

    // =========================
    // CHAT SYNC LOOP
    // =========================
    setInterval(() => {
        const chatTabActive = document.querySelector("#tab-live-chat")?.classList.contains("show");

        if (chatTabActive) {
            loadAdminChatUsers();

            if (currentChatUserId) {
                loadAdminMessages(currentChatUserId);
            }
        }
    }, 3000);
});


// =========================
// CORE FUNCTIONS
// =========================
function loadFullSiteData() {
    fetch('api/admin/get_full_site_data.php?t=' + Date.now(), {
    credentials: 'include'
})
        .then(res => res.json())
        .then(data => {
            if (data.status === 'success') {
                masterData = data;
                renderAppointments(data.appointments);
                renderUsers(data.users);
                renderVehicles(data.vehicles);
                updateStats(data);
            }
        })
        .catch(err => console.error("Fetch failed:", err));
}

function loadServiceHistory() {
    fetch('api/admin/get_service_history.php', { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            if (data.status === 'success') {
                historyData = data.history;
                document.getElementById('badgeHistory').textContent = historyData.length;
                renderHistory(historyData);
            }
        })
        .catch(() => {
            document.getElementById('historyTableBody').innerHTML =
                '<tr><td colspan="6" class="text-center text-danger py-4">Failed to load history.</td></tr>';
        });
}

function renderHistory(data) {
    const tbody = document.getElementById('historyTableBody');
    document.getElementById('historyCount').textContent =
        data.length ? `Showing ${data.length} record(s)` : '';

    if (!data.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No service history found.</td></tr>';
        return;
    }

    tbody.innerHTML = data.map(h => {
        const vehicle = h.brand && h.model
            ? `${h.brand} ${h.model} (${h.year_model || '—'})`
            : '—';
        const date = h.appointment_date
            ? new Date(h.appointment_date).toLocaleDateString('en-US', {
                month: 'short', day: 'numeric', year: 'numeric'
              })
            : '—';
        const rawDate = h.appointment_date ? h.appointment_date.substring(0, 10) : '';
        const service = h.service_type.replace(/'/g, "\\'");

        return `
        <tr>
            <td class="fw-bold">${h.full_name || '—'}</td>
            <td><span class="badge bg-light text-dark border">${h.service_type}</span></td>
            <td>${vehicle}</td>
            <td><code class="text-uppercase" style="color:#b30000;">${h.plate_number || '—'}</code></td>
            <td>${date}</td>
            <td>
                <div class="btn-group">
                    <a href="api/admin/generate_receipt.php?id=${h.id}" target="_blank"
                       class="btn btn-sm btn-outline-primary" title="View Receipt">
                        <i class="bi bi-receipt"></i>
                    </a>
                    <button class="btn btn-sm btn-outline-success"
                            onclick="sendReceiptToUser(${h.id}, '${h.full_name.replace(/'/g, "\\'")}')" title="Send Receipt">
                        <i class="bi bi-send"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-dark"
                            onclick="editHistory(${h.id}, '${service}', '${rawDate}')">
                        <i class="bi bi-pencil-square"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            onclick="deleteHistory(${h.id}, '${h.full_name.replace(/'/g, "\\'")}')">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>`;
    }).join('');
}

function sendReceiptToUser(id, name) {
    Swal.fire({
        title: 'Send Receipt?',
        text: `Do you want to send the digital receipt to ${name}?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#198754',
        confirmButtonText: 'Yes, Send Email',
        showLoaderOnConfirm: true,
        preConfirm: () => {
            return fetch('api/admin/send_receipt.php', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ appointment_id: id })
            })
            .then(response => {
                if (!response.ok) throw new Error(response.statusText);
                return response.json();
            })
            .catch(error => {
                Swal.showValidationMessage(`Request failed: ${error}`);
            });
        },
        allowOutsideClick: () => !Swal.isLoading()
    }).then((result) => {
        if (result.isConfirmed && result.value.status === 'success') {
            Swal.fire({
                icon: 'success',
                title: 'Sent!',
                text: `Receipt successfully sent to ${name}.`,
                timer: 2000,
                showConfirmButton: false
            });
        } else if (result.isConfirmed) {
            Swal.fire('Error', result.value.message || 'Failed to send receipt.', 'error');
        }
    });
}

function editHistory(id, service, date) {
    Swal.fire({
        title: 'Edit Service Record',
        html: `
            <div class="text-start mb-3">
                <label class="form-label fw-semibold small">Service Type</label>
                <input id="swal-service" class="form-control" value="${service}">
            </div>
            <div class="text-start">
                <label class="form-label fw-semibold small">Date</label>
                <input id="swal-date" type="date" class="form-control" value="${date}">
            </div>`,
        showCancelButton: true,
        confirmButtonColor: '#b30000',
        confirmButtonText: 'Save Changes',
        preConfirm: () => ({
            action:           'update',
            id:                id,
            service_type:      document.getElementById('swal-service').value.trim(),
            appointment_date: document.getElementById('swal-date').value
        })
    }).then(result => {
        if (result.isConfirmed) {
            fetch('api/admin/get_service_history.php', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(result.value)
            })
            .then(res => res.json())
            .then(data => {
                if (data.status === 'success') {
