function startRealtime() {
    async function loop() {
        try {
            await autoRefreshData(); // wait until done
        } catch (e) {
            console.error("Realtime error:", e);
        }

        setTimeout(loop, 2000); // 2s delay (faster feel)
    }

    loop();
}

