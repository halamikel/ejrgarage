function exportCSV(type) {
    let rows = [], headers = [], filename = '';

    if (type === 'appointments') {
        headers  = ['Customer', 'Service', 'Vehicle', 'Date', 'Status'];
        rows     = masterData.appointments.map(a => [
            a.full_name || 'Guest',
            a.service_type,
            a.vehicle_info || '—',
            a.appointment_date,
            a.status
        ]);
        filename = 'appointments.csv';
    } else if (type === 'users') {
        headers  = ['ID', 'Full Name', 'Email', 'Phone', 'Role', 'Joined'];
        rows     = masterData.users.map(u => [
            u.id, u.full_name, u.email,
            u.phone || '—',
            u.role_id == 2 ? 'Admin' : 'Customer',
            u.created_at || '—'
        ]);
        filename = 'users.csv';
    } else if (type === 'history') {
        headers  = ['Customer', 'Service', 'Vehicle', 'Plate No.', 'Date'];
        rows     = historyData.map(h => [
            h.full_name || '—',
            h.service_type,
            h.brand && h.model ? `${h.brand} ${h.model} (${h.year_model || '—'})` : '—',
            h.plate_number || '—',
            h.appointment_date || '—'
        ]);
        filename = 'service_history.csv';
    }

    const csv  = [headers, ...rows].map(r => r.map(c => `"${c}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
}

