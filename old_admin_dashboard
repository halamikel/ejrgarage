        title: 'Order Management',
        html: `How would you like to proceed with the order for <b>${name}</b>?`,
        icon: 'question',
        showConfirmButton: true,
        confirmButtonText: 'Yes, Approve it',
        confirmButtonColor: '#198754',
        showDenyButton: true,
        denyButtonText: 'Decline',
        denyButtonColor: '#dc3545',
        showCancelButton: true,
        cancelButtonText: 'Keep Pending'
    }).then((result) => {
        if (result.isConfirmed) {
            // Updated to 'Confirmed' to match your status map and badge
            executeStatusUpdate(id, 'Confirmed', name);
        } else if (result.isDenied) {
            executeStatusUpdate(id, 'Cancelled', name);
        }
