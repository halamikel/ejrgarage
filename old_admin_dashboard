}

// ── Chat: Load messages ──────────────────────────────────────
function loadAdminMessages(userId, userName) {
    if (!userId) return;
    
    // Store the ID globally for the end session function
    currentChatUserId = userId; 

    // 1. Show the input area and set the name
    const inputArea = document.getElementById('adminInputArea');
    if (inputArea) inputArea.classList.remove('d-none');
    
    const title = document.getElementById('chattingWithTitle');
    if (title && userName) title.textContent = `Chatting with: ${userName}`;

    fetch(`api/admin/get_messages.php?user_id=${userId}`, { credentials: 'include' })
        .then(res => res.json())
        .then(data => {
            const body = document.getElementById('adminChatBody');
            if (!body) return;

            const msgs = data.messages ?? [];
            
            body.innerHTML = msgs.length
                ? msgs.map(m => `
                    <div class="mb-3 d-flex ${m.sender === 'admin' ? 'justify-content-end' : 'justify-content-start'}">
                        <div class="p-3 rounded-3 shadow-sm" style="max-width:75%; 
                            ${m.sender === 'admin' 
                                ? 'background:#b30000;color:white;' 
                                : 'background:#fff;border:1px solid #ddd;'}">
                            <div>${m.message}</div>
                            <small style="font-size:0.7rem;display:block;margin-top:5px;opacity:0.8;">${m.time}</small>
                        </div>
                    </div>`).join('')
                : '<div class="text-center text-muted mt-5">No messages yet.</div>';

            body.scrollTop = body.scrollHeight;
        })
        .catch(err => console.error('Messages error:', err));
}

// ── Chat: Send reply ─────────────────────────────────────────
function sendAdminReply() {
    const input = document.getElementById('adminReplyInput');
    const msg   = input.value.trim();
    if (!msg || !currentChatUserId) return;

    fetch('api/admin/send_message.php', {   // ← exact path
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: currentChatUserId, message: msg })
    })
    .then(res => res.json())
    .then(data => {
        if (data.status === 'success') {
            document.getElementById('adminReplyInput').value = '';
            loadAdminMessages(currentChatUserId);
            loadAdminChatUsers();
        } else {
            console.error('Send failed:', data.message);
        }
    })
    .catch(err => console.error('Send error:', err));
}

// ── Chat: End live session ───────────────────────────────────
function endLiveSession() {
    if (!currentChatUserId) return;

    Swal.fire({
        title: 'End Live Session?',
        text: "This will switch the user back to Bot Mode.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ffc107',
        confirmButtonText: 'Yes, End Session'
    }).then((result) => {
        if (result.isConfirmed) {
            // DOUBLE CHECK: Is your file named end_live_session.php or end_session.php?
            fetch('api/admin/end_session.php', { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ user_id: currentChatUserId })
            })
            .then(res => {
                if (!res.ok) throw new Error('File not found (404) or Server Error');
                return res.json();
            })
            .then(data => {
                if (data.status === 'success') {
                    // 1. Hide the input area instantly
                    const inputArea = document.getElementById('adminInputArea');
                    if (inputArea) inputArea.classList.add('d-none');

                    // 2. Reset the chat body text
                    document.getElementById('adminChatBody').innerHTML = `
                        <div class="text-center mt-5 text-muted">
                            <i class="bi bi-chat-left-dots fs-1 d-block mb-2"></i>
                            <p>Select a customer to start chatting</p>
                        </div>`;
                    
                    currentChatUserId = null;
                    Swal.fire('Ended', 'Session closed.', 'success');
                    loadAdminChatUsers(); 
                } else {
                    Swal.fire('Error', data.message || 'Failed to end session', 'error');
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire('System Error', 'The file api/admin/end_live_session.php was not found.', 'error');
