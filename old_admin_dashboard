function statusBadge(status) {
    if (!status) return `<span class="badge bg-secondary">Unknown</span>`;

    // .toLowerCase() ensures "Approved", "approved", and "APPROVED" all match 'approved'
    const s = status.toLowerCase().trim();
    
    const map = {
        'pending':   'bg-warning text-dark',
        'approved':  'bg-success', // Force Green
        'confirmed': 'bg-success', // Force Green
        'completed': 'bg-success', // Force Green
        'cancelled': 'bg-danger'
    };
    
    // Capitalize for the UI display
    const displayStatus = s.charAt(0).toUpperCase() + s.slice(1);
    
    return `<span class="badge ${map[s] || 'bg-secondary'}">${displayStatus}</span>`;
}

