# EJR Garage - root .htaccess

# ── Security headers (OWASP) ──────────────────────────────────
<IfModule mod_headers.c>
    # Force HTTPS on every future visit (1 year, include subdomains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Prevent clickjacking — page can only be framed by same origin
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing — browser must respect declared Content-Type
    Header always set X-Content-Type-Options "nosniff"

    # Don't leak full URLs to external sites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Lock down powerful browser features this site doesn't use
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), usb=(), payment=(self)"

    # Minimal legacy XSS header (CSP below is the real protection)
    Header always set X-XSS-Protection "1; mode=block"

    # Content-Security-Policy — allow-listed to the third-party assets
    # this site actually loads (jsDelivr, cdnjs, jQuery CDN, Google Fonts,
    # Elfsight review widget, Google Maps embed). Tighten further if any
    # of these integrations are removed.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://code.jquery.com https://elfsightcdn.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https://res.cloudinary.com https://elfsightcdn.com https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https://elfsightcdn.com https://core.service.elfsight.com https://static.elfsight.com; frame-src 'self' https://www.google.com https://elfsightcdn.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"

    # ZAP-flagged: X-Powered-By leaks the exact PHP version to attackers.
    # expose_php can't be set in .htaccess (it's PHP_INI_SYSTEM), so it's
    # disabled via a php.ini snippet in the Dockerfile instead — this line
    # is a defense-in-depth backstop in case anything re-adds the header.
    Header unset X-Powered-By
</IfModule>

# ── Session cookie hardening (ZAP: missing HttpOnly/Secure/SameSite) ──
# Applies globally to every session_start() call in the codebase without
# having to touch each of the ~30 files that call it individually.
<IfModule mod_php.c>
    php_flag session.cookie_httponly On
    php_flag session.cookie_secure On
    php_value session.cookie_samesite Lax
</IfModule>

# ── Allow AJAX/fetch requests (fixes InfinityFree 403 on API calls) ──
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "https://ejrgarage.onrender.com"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type"
</IfModule>

# Handle OPTIONS preflight
RewriteEngine On
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule .* - [R=200,L]

# CRITICAL FIX: Pass Authorization header through to PHP
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Fallback for CGI/FastCGI setups
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# Block direct access to sensitive config files
<FilesMatch "^(db_config\.php|mail_config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes