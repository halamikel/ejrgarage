<?php
header('Content-Type: application/json');
require_once '../db_config.php'; // Correct path to your config

$db = isset($pdo) ? $pdo : (isset($conn) ? $conn : null);
$data = json_decode(file_get_contents("php://input"), true);

if (isset($data['user_id']) && isset($data['role_id'])) {
    try {
        $stmt = $db->prepare("UPDATE users SET role_id = ? WHERE id = ?");
        $stmt->execute([$data['role_id'], $data['user_id']]);
        
        echo json_encode(['status' => 'success', 'message' => 'Role updated']);
    } catch (Exception $e) {
        echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
    }
}
?>