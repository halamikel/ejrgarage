# Staging environment — Azure Database for MySQL (Flexible Server)
# Copy this to api/.env.testing, fill in real values, never commit it.
#
# IMPORTANT: this must be an "Azure Database for MySQL" resource
# (wire-compatible with MySQLi, like TiDB), NOT "Azure SQL Database" /
# SQL Server. The two are different products with different drivers —
# this codebase's api/*.php files use mysqli throughout and cannot
# talk to Azure SQL Server without a full driver rewrite.

DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=ejrgarage_staging_db
DB_USERNAME=3TtCZaQ7oWBM4mm.root
DB_PASSWORD=bi7DcosrZLLkrx1e

# Azure's CA bundle differs from TiDB's (isrgrootx1.pem, used in production).
# Download Microsoft's recommended combined bundle and save it to
# certificates/DigiCertGlobalRootCA.crt.pem, then point this at it:
#   https://learn.microsoft.com/azure/mysql/flexible-server/how-to-connect-tls-ssl

# Keep the same secret as production unless you want staging tokens to
# be independently invalid — either is fine, this just needs to be set.
JWT_SECRET=same_or_new_secret_here

# Safe to reuse production values here — emails to test addresses are
# harmless, or leave blank to have sendVerificationEmail() fail silently
# (it only error_logs, it does not break the request/response).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Only needed if your tests touch payment or SMS-sending endpoints.
PAYMONGO_SECRET_KEY=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE

# Only needed if your tests touch avatar upload endpoints.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
